
# Configuration locale, sans secrets
APP_ENV=development
DATABASE_PATH=data/pfe_copilot.db

# Email sending is approval-based unless explicitly enabled.
AUTOMATED_SENDING_ENABLED=false
# Optional comma-separated exact recipient allowlist.
EMAIL_RECIPIENT_ALLOWLIST=

# Gmail OAuth : à configurer lors de l'étape d'intégration.
